<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.StudyBuddy" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Black and Light Blue Dark Theme -->
        <item name="colorPrimary">@color/light_blue_primary</item>
        <item name="colorPrimaryVariant">@color/light_blue_variant</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/light_blue_secondary</item>
        <item name="colorSecondaryVariant">@color/light_blue_variant</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>

        <!-- Material Components theme attributes -->
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>
    </style>
</resources>